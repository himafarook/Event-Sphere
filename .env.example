# Copy to .env (never commit .env). All are optional for local dev.
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./eventsphere.db
AGENT_API_KEY=change-me-too
COOKIE_SECURE=0
HOLD_MINUTES=10
SWEEP_SECONDS=30
TZ_OFFSET_MINUTES=330
CHECKIN_OPEN_HOURS=2
SEED_DEMO=1
